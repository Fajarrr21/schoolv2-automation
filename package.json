{
  "name": "stagingv2-automation",
  "version": "1.0.0",
  "description": "Cypress E2E CARDS School V2 (staging)",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:debug": "cypress run --headed --no-exit --browser chrome",
    "report:clean": "node -e \"require('fs').rmSync('cypress/reports', {recursive: true, force: true})\"",
    "report:merge": "mochawesome-merge cypress/reports/mochawesome*.json > cypress/reports/merged.json",
    "report:generate": "marge cypress/reports/merged.json -o cypress/reports --inline",
    "report:build": "run-s report:merge report:generate",
    "test": "run-s report:clean cy:run --continue-on-error report:build",
    "_comment:cy": "cy:* = jalankan Cypress saja. test:* = clean -> cy:* -> report:build lewat run-s. JANGAN pakai & sebagai pemisah: exit code Cypress ditelan. Cleanup TIDAK ikut glob modul; jalankan sendiri: npm run cy:cleanup:tahfidz.",
    "cy:smoke": "cypress run --spec \"cypress/e2e/stagingv2/Login/*.cy.js\"",
    "cy:tahfidz": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/tambahriwayat.cy.js,cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/pilihayat.cy.js,cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/rentangayat.cy.js,cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/ayatterkunci.cy.js,cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/editriwayat.cy.js,cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/penulisancapaian.cy.js,cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/export.cy.js,cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/hapusriwayat.cy.js\"",
    "cy:tahfidz:tambahriwayat": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/tambahriwayat.cy.js\"",
    "cy:tahfidz:pilihayat": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/pilihayat.cy.js\"",
    "cy:tahfidz:rentangayat": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/rentangayat.cy.js\"",
    "cy:tahfidz:ayatterkunci": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/ayatterkunci.cy.js\"",
    "cy:tahfidz:editriwayat": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/editriwayat.cy.js\"",
    "cy:tahfidz:penulisancapaian": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/penulisancapaian.cy.js\"",
    "cy:tahfidz:export": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/export.cy.js\"",
    "cy:tahfidz:hapusriwayat": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/capaian-multiselect/hapusriwayat.cy.js\"",
    "cy:batas": "cypress run --spec \"cypress/e2e/stagingv2/Pengaturan/Kesiswaan/batas-tahfidz/pengaturanbatas.cy.js,cypress/e2e/stagingv2/Pengaturan/Kesiswaan/batas-tahfidz/hakakses.cy.js,cypress/e2e/stagingv2/Kesiswaan/Tahfidz/improvement-batas/batasprogram.cy.js,cypress/e2e/stagingv2/Kesiswaan/Tahfidz/improvement-batas/detailprogram.cy.js,cypress/e2e/stagingv2/Kesiswaan/Tahfidz/improvement-batas/filterbatas.cy.js,cypress/e2e/stagingv2/Kesiswaan/Tahfidz/improvement-batas/detailanggota.cy.js,cypress/e2e/stagingv2/Kesiswaan/Tahfidz/improvement-batas/formriwayat.cy.js,cypress/e2e/stagingv2/Kesiswaan/Tahfidz/improvement-batas/riwayatbatas.cy.js,cypress/e2e/stagingv2/Kesiswaan/Tahfidz/improvement-batas/mushaf.cy.js\"",
    "cy:pengaturan:batas": "cypress run --spec \"cypress/e2e/stagingv2/Pengaturan/Kesiswaan/batas-tahfidz/pengaturanbatas.cy.js\"",
    "cy:batas:batasprogram": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/improvement-batas/batasprogram.cy.js\"",
    "cy:batas:detailprogram": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/improvement-batas/detailprogram.cy.js\"",
    "cy:batas:filterbatas": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/improvement-batas/filterbatas.cy.js\"",
    "cy:batas:detailanggota": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/improvement-batas/detailanggota.cy.js\"",
    "cy:batas:formriwayat": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/improvement-batas/formriwayat.cy.js\"",
    "cy:batas:riwayatbatas": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/improvement-batas/riwayatbatas.cy.js\"",
    "cy:batas:mushaf": "cypress run --spec \"cypress/e2e/stagingv2/Kesiswaan/Tahfidz/improvement-batas/mushaf.cy.js\"",
    "cy:cleanup:tahfidz": "cypress run --config trashAssetsBeforeRuns=false --spec \"cypress/e2e/stagingv2/cleanup/cleanupTahfidz.cy.js\"",
    "cy:cleanup:batas": "cypress run --config trashAssetsBeforeRuns=false --spec \"cypress/e2e/stagingv2/cleanup/cleanupBatas.cy.js,cypress/e2e/stagingv2/cleanup/cleanupFoto.cy.js\"",
    "test:tahfidz": "run-s report:clean cy:tahfidz report:build --continue-on-error",
    "test:batas": "run-s report:clean cy:batas report:build --continue-on-error",
    "cy:staging": "cypress run --env environment=staging",
    "open:staging": "cypress open --env environment=staging",
    "cy:pengaturan:hakakses": "cypress run --spec \"cypress/e2e/stagingv2/Pengaturan/Kesiswaan/batas-tahfidz/hakakses.cy.js\""
  },
  "author": "Fajar",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "cypress": "^16.1.1",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "npm-run-all": "^4.1.5",
    "xlsx": "^0.18.5"
  }
}
